# 로컬 Docker MongoDB (docker compose up -d)
MONGODB_URI=mongodb://localhost:27017

# MongoDB Atlas를 쓰려면 위 줄을 아래 형식으로 바꾼다. 비밀번호가 들어가므로 .env.local에만 적는다.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# 데이터베이스 이름. Atlas Data Explorer에 이 이름으로 나타난다.
MONGODB_DB=todoapp
